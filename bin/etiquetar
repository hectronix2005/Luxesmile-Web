#!/usr/bin/env bash
# bin/etiquetar <commit> — etiqueta un despliegue que ya pasó la sonda.
#
# Crea la etiqueta anotada vAAAA.MM.DD-N (fecha de Bogotá; N = 1, 2… en el día) sobre el
# commit, la sube y crea la Release de GitHub con notas generadas. No hace nada si el
# commit ya tiene etiqueta o si es un commit de rollback (ese ya ES una versión vieja).
# Lo llama .github/workflows/versiones.yml tras la sonda en verde. Nunca falla el
# despliegue: si algo sale mal, avisa y sale con 0.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 0
# shellcheck source=bin/_versiones.sh
. bin/_versiones.sh

sha="${1:?uso: bin/etiquetar <commit>}"
aviso() { echo "::warning::etiquetar: $*"; echo "etiquetar: $*" >&2; }

git fetch --quiet --force --tags origin || aviso "no pude traer las etiquetas de origin"
sha="$(git rev-parse --verify "$sha^{commit}" 2>/dev/null)" || { aviso "no conozco el commit $1"; exit 0; }

ya="$(git tag --points-at "$sha" -l 'v[0-9]*' | head -1)"
if [ -n "$ya" ]; then echo "etiquetar: ${sha:0:7} ya es $ya; nada que hacer"; exit 0; fi
if git log -1 --format=%s "$sha" | grep -q '^rollback:'; then
  echo "etiquetar: ${sha:0:7} es un commit de rollback; no se etiqueta"; exit 0
fi

dia="$(TZ=America/Bogota date +%Y.%m.%d)"
n="$(git tag -l "v$dia-*" | sed "s/^v$dia-//" | grep -E '^[0-9]+$' | sort -n | tail -1)"
n=$(( ${n:-0} + 1 ))
quien=(-c "user.name=${GIT_AUTHOR_NAME:-luxe-versiones[bot]}" -c "user.email=${GIT_AUTHOR_EMAIL:-41898282+github-actions[bot]@users.noreply.github.com}")

for _ in 1 2 3; do
  tag="v$dia-$n"
  if git "${quien[@]}" tag -a "$tag" "$sha" -m "Despliegue $tag (${sha:0:7}): sonda en verde" \
     && git push --quiet origin "refs/tags/$tag"; then
    echo "etiquetar: ${sha:0:7} → $tag"
    if command -v gh >/dev/null 2>&1; then
      gh release create "$tag" --verify-tag --generate-notes --title "$tag" >/dev/null \
        || aviso "la etiqueta $tag quedó, pero no pude crear la Release"
    fi
    exit 0
  fi
  # Otra ejecución cogió ese número: lo dejo y pruebo el siguiente.
  git tag -d "$tag" >/dev/null 2>&1
  git fetch --quiet --force --tags origin
  n=$(( n + 1 ))
done
aviso "no pude crear la etiqueta para ${sha:0:7}"
exit 0
